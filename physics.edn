;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a rail-crew scheduling and logistics
;; coordination robot logs service records, proposes crew rosters and
;; coordinates maintenance orders; it never operates the locomotive. The
;; physical work it plans around is the train's run: a freight leg between
;; stops on a gradient (what a roster slot must fit), and in the depot it
;; handles the brake blocks its maintenance orders bring in.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-8311"
 :cases
 [{:id :freight-leg-on-gradient
   :kind :transport
   :procedure "1000 t freight train, 300 kN tractive effort, runs 3 km from stand to stand up a constant gradient at up to 80 km/h and stops at 0.5 m/s2"
   :params {:mass-kg 1.0e6 :payload-kg 0.0 :distance-m 3000.0 :v-max-mps 22.0 :a-max-mps2 0.3
            :brake-decel-mps2 0.5 :drive-force-n 300000.0 :crr 0.002
            :cog-height-m 1.8 :support-half-length-m 0.7175 :max-time-s 1200.0}
   :sweep {:param :slope-deg :values [0.0 0.2 0.4 0.6 0.8]}
   :quantity :cycle-time-s
   :limit {:max 220.0 :basis "estimate: timetable path of about 3.7 minutes for the section"}
   :boundary {:lo 0.0 :hi 1.2}}
  {:id :brake-block-to-rack
   :kind :manipulator
   :procedure "depot arm lifts a replacement brake block from the delivery pallet onto the fitting rack"
   :params {:l1-m 0.60 :l2-m 0.55 :m1-kg 8.0 :m2-kg 5.0
            :from [0.70 0.10] :to [0.45 0.70] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [4.0 6.0 8.0 10.0 12.0 14.0]}
   :quantity :peak-tau1-nm
   :limit {:max 150.0 :basis "estimate: continuous shoulder torque of a ~10 kg payload collaborative arm"}
   :boundary {:lo 0.5 :hi 40.0}}]}
